    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH nxt AS (SELECT COALESCE(MAX(SUBSTRING(sample_id FROM 5)::int),0)+1 AS n FROM samples),\ns AS (INSERT INTO samples (sample_id, sample_reference, laboratory_id, laboratory_name, sample_type, customer_type, customer_name, sample_quantity, received_date, expected_result_date, sample_price_before_vat, region) SELECT 'SMP-'||LPAD(n::text,6,'0'), 'OCL-'||EXTRACT(YEAR FROM CURRENT_DATE)::int||'-'||LPAD(n::text,6,'0'), split_part($1::text,' | ',1), split_part($1::text,' | ',2), $2::text, $3::text, $4::text, $5::int, CURRENT_DATE, CURRENT_DATE+$6::int, $7::numeric, $8::text FROM nxt RETURNING sample_id, sample_reference, sample_quantity, sample_price_before_vat),\nf AS (INSERT INTO finance (sample_id, sample_reference, unit_price, quantity, student_discount_rate, subtotal_before_vat, vat_rate, vat_amount, total_amount, paid_amount, outstanding_amount, payment_method, payment_status, payment_date) SELECT sample_id, sample_reference, ROUND(sample_price_before_vat/NULLIF(sample_quantity,0),2), sample_quantity, 0, sample_price_before_vat, 15, ROUND(sample_price_before_vat*0.15,2), ROUND(sample_price_before_vat*1.15,2), 0, ROUND(sample_price_before_vat*1.15,2), $9::text, 'Unpaid', NULL FROM s RETURNING sample_id),\nr AS (INSERT INTO results (sample_id, sample_reference, report_status, is_delayed, result_collected) SELECT sample_id, sample_reference, 'Pending', false, false FROM s RETURNING sample_id)\nSELECT sample_id, sample_reference FROM s;",
        "options": {
          "queryReplacement": "={{ [$json['Laboratory'], $json['Sample Type'], $json['Customer Type'], $json['Customer Name'], $json['Quantity'], $json['Turnaround Days'], $json['Total Price Before VAT'], $json['Region'], $json['Payment Method']] }}"
        }
      },
